<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Stop-Loss 계산기 — MacTrader</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
  :root {
    --bg:      #0f1117;
    --card:    #1a1d27;
    --border:  #2a2d3a;
    --accent:  #5b8ef0;
    --accent2: #7c6fff;
    --green:   #2ecc71;
    --red:     #e74c3c;
    --yellow:  #f1c40f;
    --text:    #e8eaf0;
    --muted:   #7a7f96;
    --input-bg:#22253a;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, 'Segoe UI', sans-serif;
    min-height: 100vh;
    padding: 32px 16px 80px;
  }
  h1 {
    text-align: center;
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 4px;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .subtitle { text-align: center; color: var(--muted); font-size: 0.82rem; margin-bottom: 32px; }
  .container { max-width: 640px; margin: 0 auto; }

  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 24px 24px 20px;
    margin-bottom: 18px;
  }
  .card-title { font-size: 0.78rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-bottom: 18px; }

  .field { margin-bottom: 14px; }
  .field label { display: block; font-size: 0.78rem; color: var(--muted); margin-bottom: 5px; font-weight: 500; }
  .field input[type="text"],
  .field input[type="number"] {
    width: 100%;
    background: var(--input-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px 14px;
    color: var(--text);
    font-size: 0.97rem;
    outline: none;
    transition: border-color .15s;
  }
  .field input:focus { border-color: var(--accent); }
  .field input::placeholder { color: var(--muted); font-size: 0.88rem; }
  .field .hint { font-size: 0.72rem; color: var(--muted); margin-top: 4px; }

  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

  /* Tightness 슬라이더 */
  .tightness-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 2px;
  }
  .tightness-row span.tag {
    font-size: 0.7rem;
    color: var(--muted);
    white-space: nowrap;
    min-width: 22px;
  }
  input[type="range"] {
    flex: 1;
    accent-color: var(--accent);
    cursor: pointer;
    height: 4px;
  }
  .tightness-badge {
    display: inline-block;
    min-width: 32px;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
  }

  #calcBtn {
    width: 100%;
    padding: 13px;
    border: none;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: #fff;
    font-size: 0.97rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity .2s, transform .1s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 4px;
  }
  #calcBtn:hover { opacity: .9; }
  #calcBtn:active { transform: scale(0.98); }
  #calcBtn:disabled { opacity: .5; cursor: not-allowed; }

  #errBox {
    display: none;
    background: #2b1218;
    border: 1px solid var(--red);
    border-radius: 12px;
    padding: 12px 16px;
    color: #ff7070;
    font-size: 0.85rem;
    margin-bottom: 18px;
    line-height: 1.6;
  }

  #result { display: none; }

  .result-ticker { display: flex; align-items: baseline; gap: 10px; margin-bottom: 14px; }
  .result-ticker .sym { font-size: 1.5rem; font-weight: 800; }
  .result-ticker .meta { color: var(--muted); font-size: 0.78rem; line-height: 1.5; }
  .result-ticker .meta span { display: block; }

  .profit-banner { display: flex; align-items: center; gap: 10px; border-radius: 10px; padding: 10px 14px; margin-bottom: 14px; }
  .profit-banner.positive { background: #0e2318; border: 1px solid #1e5c35; }
  .profit-banner.negative { background: #1e0e0e; border: 1px solid #5c1e1e; }
  .profit-banner.neutral  { background: #1a1d27; border: 1px solid var(--border); }
  .profit-banner .pct { font-size: 1.4rem; font-weight: 800; min-width: 75px; }
  .profit-banner.positive .pct { color: var(--green); }
  .profit-banner.negative .pct { color: var(--red); }
  .profit-banner.neutral  .pct { color: var(--muted); }
  .profit-banner .pct-detail { font-size: 0.73rem; color: var(--muted); margin-top: 2px; }
  .phase-tag { margin-left: auto; font-size: 0.68rem; padding: 4px 9px; border-radius: 6px; background: rgba(255,255,255,.06); color: var(--muted); text-align: right; line-height: 1.4; white-space: pre-line; }

  .stop-display { text-align: center; padding: 16px; background: var(--input-bg); border-radius: 12px; margin-bottom: 14px; }
  .stop-display .slabel { font-size: 0.7rem; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 5px; }
  .stop-display .price { font-size: 2.2rem; font-weight: 800; }
  .stop-display .price.safe   { color: var(--green); }
  .stop-display .price.warn   { color: var(--yellow); }
  .stop-display .price.danger { color: var(--red); }
  .stop-display .pct-away { font-size: 0.8rem; color: var(--muted); margin-top: 2px; }

  .breakdown { margin-top: 2px; }
  .brow { display: flex; justify-content: space-between; align-items: center; padding: 7px 0; border-bottom: 1px solid var(--border); font-size: 0.85rem; }
  .brow:last-child { border-bottom: none; }
  .brow .blabel { color: var(--muted); display: flex; align-items: center; gap: 5px; }
  .brow .bval { font-weight: 600; font-variant-numeric: tabular-nums; }
  .brow .bval.active { color: var(--accent); }
  .brow .bval.yellow { color: var(--yellow); }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); flex-shrink: 0; }
  .dot.active { background: var(--accent); }
  .dot.yellow { background: var(--yellow); }

  .chart-card { position: relative; }
  .chart-title {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: .07em;
    color: var(--muted);
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .chart-wrap { position: relative; height: 260px; }
  .chart-wrap canvas { width: 100% !important; }

  .explain-compact {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 18px 20px;
    margin-bottom: 18px;
  }
  .explain-title { font-size: 0.78rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-bottom: 14px; }
  .phase-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.82rem;
  }
  .phase-row:last-child { border-bottom: none; }
  .phase-num {
    flex-shrink: 0;
    width: 22px; height: 22px;
    border-radius: 50%;
    background: var(--input-bg);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.7rem; font-weight: 700;
    color: var(--accent);
    margin-top: 1px;
  }
  .phase-content .pname { font-weight: 600; color: var(--text); margin-bottom: 2px; }
  .phase-content .pdesc { color: var(--muted); line-height: 1.5; }
  .formula-inline {
    display: inline-block;
    background: #12151f;
    border-left: 2px solid var(--accent);
    padding: 3px 8px;
    border-radius: 0 5px 5px 0;
    font-family: monospace;
    font-size: 0.73rem;
    color: #a8c0ff;
    margin-top: 4px;
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .grid2 { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>
<div class="container">

  <h1>Stop-Loss 계산기</h1>
  <p class="subtitle">MacTrader 트레일링 스탑 — 진입일부터 래칫 시뮬레이션</p>

  <div class="card">
    <div class="card-title">종목 정보</div>

    <div class="grid2">
      <div class="field">
        <label>티커 심볼</label>
        <input type="text" id="ticker" placeholder="SEPN / 010950" autocomplete="off" autocapitalize="characters">
      </div>
      <div class="field">
        <label>구매일</label>
        <input type="text" id="entryDate" placeholder="2026-07-01">
        <div class="hint">YYYY-MM-DD 또는 YYYYMMDD</div>
      </div>
    </div>

    <div class="grid2">
      <div class="field">
        <label>평단가</label>
        <input type="number" id="entryPrice" placeholder="36.47 / 119655" step="any" min="0">
      </div>
      <div class="field">
        <label>초기 손절 %</label>
        <div style="display:flex;align-items:center;gap:8px;">
          <input type="number" id="stopPct" value="8" min="1" max="30" step="0.5" style="width:80px;">
          <input type="range" id="stopSlider" min="1" max="15" step="0.5" value="8"
                 style="flex:1;accent-color:var(--accent);cursor:pointer;">
        </div>
        <div class="hint" id="stopHint">−8% 고정 유지 → 도달 최고 종가가 +8%에 닿으면 평단가로 1회 점프</div>
      </div>
    </div>

    <!-- Tightness 슬라이더 -->
    <div class="field" style="margin-bottom:18px;">
      <label>
        Stop 밀착도 (Tightness)
        <span class="tightness-badge" id="tightnessVal">50</span>
        <span style="font-size:0.7rem;color:var(--muted);font-weight:400;margin-left:4px;">/ 100</span>
      </label>
      <div class="tightness-row">
        <span class="tag">여유 0</span>
        <input type="range" id="tightnessSlider" min="0" max="100" step="1" value="50">
        <span class="tag">100 밀착</span>
      </div>
      <div class="hint">50 = 기본값 · 높을수록 주가 밀착 추적 · 낮을수록 여유 있게</div>
    </div>

    <button id="calcBtn" onclick="calculate()">
      <span id="btnIcon">📊</span>
      <span id="btnText">Stop 시뮬레이션 실행</span>
    </button>
  </div>

  <div id="errBox"></div>

  <!-- 결과 -->
  <div id="result">

    <div class="card">
      <div class="result-ticker">
        <span class="sym" id="rTicker"></span>
        <span class="meta">
          <span id="rDays"></span>
          <span id="rYfLabel" style="color:#555;font-size:0.7rem;"></span>
        </span>
      </div>

      <div class="profit-banner" id="profitBanner">
        <div>
          <div class="pct" id="rProfit"></div>
          <div class="pct-detail" id="rPriceInfo"></div>
        </div>
        <div class="phase-tag" id="rPhaseTag"></div>
      </div>

      <div class="stop-display">
        <div class="slabel">래칫 시뮬레이션 Stop 라인</div>
        <div class="price" id="rStop"></div>
        <div class="pct-away" id="rStopAway"></div>
      </div>

      <div class="breakdown">
        <div class="brow">
          <span class="blabel"><span class="dot" id="d1"></span>초기 손절 (<span id="initLabel">−8%</span>)</span>
          <span class="bval" id="b1"></span>
        </div>
        <div class="brow">
          <span class="blabel"><span class="dot" id="d2"></span>Floor (계단: −n% / 본전)</span>
          <span class="bval" id="b2"></span>
        </div>
        <div class="brow">
          <span class="blabel"><span class="dot" id="d4"></span>이익 잠금 (<span id="lockLabel">—</span>)</span>
          <span class="bval" id="b4"></span>
        </div>
        <div class="brow">
          <span class="blabel"><span class="dot" id="d3"></span>MA<span id="maPer"></span> 트레일링</span>
          <span class="bval" id="b3"></span>
        </div>
        <div class="brow" style="padding-top:10px;">
          <span class="blabel" style="color:var(--text);font-weight:600;">✅ 최종 래칫 Stop</span>
          <span class="bval active" id="b5" style="font-size:1rem;"></span>
        </div>
      </div>
    </div>

    <div class="card chart-card">
      <div class="chart-title">📈 주가 + Stop 라인 히스토리</div>
      <div class="chart-wrap"><canvas id="chartPrice"></canvas></div>
    </div>

    <div class="card chart-card">
      <div class="chart-title">🔢 수익률별 Stop 라인 이론 곡선</div>
      <div class="chart-wrap"><canvas id="chartTheory"></canvas></div>
      <div style="font-size:0.72rem;color:var(--muted);margin-top:8px;line-height:1.5;">
        MA 트레일링은 실제 주가 데이터에 따라 달라지므로 이론 곡선에서는 Floor + 이익잠금만 표시합니다.<br>        또한 이론 곡선은 <b>경로를 모르므로</b> 본전 도달 여부를 현재 수익률로 판정합니다 — 실제로는 과거에 한 번 +8%를 찍었다면 지금 수익률이 그 아래여도 본전 floor가 유지됩니다(위 시뮬레이션 차트가 정확).
      </div>
    </div>

  </div>

  <div class="explain-compact">
    <div class="explain-title">계산 방식</div>
    <div class="phase-row">
      <div class="phase-num">1</div>
      <div class="phase-content">
        <div class="pname">구간1 — 계단 (본전 도달 전)</div>
        <div class="pdesc">진입 후 <b>도달 최고 종가</b>가 +8%에 닿기 전까지 스탑을 <b>−n%에 그대로</b> 둔다.
          MA·이익잠금이 이 구간을 끌어올리지 못하며, <b>래칫도 걸리지 않는다</b>(한 번 올라간 스탑도 −n%로 되돌아옴).
          MA가 −n%보다 아래여도 <b>하한 클램프</b>로 −n% 밑으로는 내려가지 않는다.
          <br>기본값 n = 8 → −8% 고정.</div>
        <div class="formula-inline">floor = entry × (1−n) · stop = max(그 결과, entry × (1−n))</div>
      </div>
    </div>
    <div class="phase-row">
      <div class="phase-num">→</div>
      <div class="phase-content">
        <div class="pname">전환 — 본전 도달 (+8%, 라이브 고정값)</div>
        <div class="pdesc"><b>도달 최고 종가</b>가 매수가 대비 +8%에 닿는 순간 floor가 <b>−n% → 본전으로 1회 점프</b>한다.
          이 판정은 <b>되돌아가지 않는다</b> — 이후 주가가 밀려도 구간1로 복귀하지 않는다.
          장중 고가는 쓰지 않고 <b>확정 종가</b>만 본다.
          <br>⚠️ +8%는 라이브의 <b>고정 리터럴</b>이라 n을 바꿔도 따라 움직이지 않는다(예: n=4면 +8%까지 −4% 유지).</div>
        <div class="formula-inline">be_reached = max(진입 후 종가) / entry − 1 ≥ 0.08</div>
      </div>
    </div>
    <div class="phase-row">
      <div class="phase-num">2</div>
      <div class="phase-content">
        <div class="pname">이익 잠금 사다리 (+8%~) — <b>먼저 구속하는 쪽</b></div>
        <div class="pdesc">이익 일부를 영구 보호 — tightness에 따라 잠금 비율 0.3x~1.7x 조절.
          기산점 +8% 고정(라이브 <code>lock_start</code>).
          <br>구간2의 최종 stop은 <b>max(잠금 floor, MA 블렌드)</b>인데, 상승 종목은 MA가 주가보다 한참 아래에 있어
          <b>대부분 구간에서 잠금 floor가 실제 스탑을 결정</b>한다.</div>
        <div class="formula-inline">lock = base_lock × lerp(0.3, 1.7, tightness/100)</div>
      </div>
    </div>
    <div class="phase-row">
      <div class="phase-num">3</div>
      <div class="phase-content">
        <div class="pname">MA 트레일링 (+5% ~ +20%) — <b>나중에 인수</b></div>
        <div class="pdesc">수익이 커질수록 MA 기간 단축 (90일→30일 × tightness 배율), 가격을 더 밀착 추적.
          블렌드 가중은 +5%~+20% 구간(라이브 고정값)이며, MA 값이 잠금 floor를 넘어설 때부터 스탑을 끌어올리는 주체가 된다.
          <br>구간1에서는 하한 클램프에 막혀 스탑에 영향을 주지 못한다.</div>
        <div class="formula-inline">MA_period = max(10, round(base × lerp(1.5, 0.5, tightness/100)))</div>
      </div>
    </div>
    <div class="phase-row">
      <div class="phase-num">↑</div>
      <div class="phase-content">
        <div class="pname">래칫 — 구간2에서만 작동</div>
        <div class="pdesc">본전 도달 <b>이후</b>에는 이전 Stop보다 낮아지지 않는다.
          구간1에서는 래칫이 꺼져 있어 스탑이 −n%로 되돌아갈 수 있다 — 이번 개정의 핵심 변화점.</div>
      </div>
    </div>
  </div>

  <div style="font-size:0.72rem;color:#7a7f96;line-height:1.6;border:1px solid #2a2d3a;
              border-radius:8px;padding:10px 12px;margin-top:4px;background:#14161f;">
    ✅ <b>라이브 엔진과 동일</b> (2026-08-19 기준, 블록 <code>STOPFLAT-WIRE-20260818</code>) —
    <code>exit_engine_unified.py</code> 의 계단 floor · 도달 최고 종가 기준 본전 판정 ·
    구간1 래칫 미적용 · 구간1 하한 클램프 · <code>w_ma</code>(0.05~0.20) ·
    <code>lock_start</code>(0.08) · <code>ma_period_for</code> 를 그대로 옮겼습니다.
    <br>남은 차이 3가지: ① <b>Stop 밀착도(tightness)</b> 는 계산기 전용 조절값 — 라이브에는 없고
    50에서 라이브와 정확히 일치합니다. ② <b>P-E 분할손절</b>·피벗 실패 룰은 범위 제외.
    ③ 이론 곡선(아래쪽 차트)은 경로를 모르므로 본전 도달을 현재 수익률로 폴백 판정합니다.
  </div>

  <div style="text-align:center;font-size:0.72rem;color:#3a3f55;padding-top:4px;">
    📡 Yahoo Finance · 전일 종가 기준 · LLM 없음 · 토큰 0원
  </div>

</div>

<script>
// ── 수학 ──────────────────────────────────────────
function lerp(a, b, t) { return a + (b - a) * t; }

function smoothstep(x, lo, hi) {
  if (hi <= lo) return x >= hi ? 1 : 0;
  const t = Math.max(0, Math.min(1, (x - lo) / (hi - lo)));
  return t * t * (3 - 2 * t);
}

// tightness 0~100: 50=기본값
// MA period: 50→base, 100→0.5×base(짧고 빠름), 0→1.5×base(길고 느림)
function maPeriodFor(profit, tightness) {
  const base = Math.max(30, Math.round(90 - 34.64 * Math.sqrt(Math.max(0, profit))));
  const mult = lerp(1.5, 0.5, tightness / 100);
  return Math.max(10, Math.round(base * mult));
}

// ── [STOPFLAT-WIRE-20260818] 라이브 exit_engine_unified.py 리터럴 그대로 ──
//   전부 initial_stop_pct 와 **무관한 고정 리터럴**이다 (라이브에서 연동되지 않음).
const BE_FLOOR   = 0.08;   // BREAKEVEN_TRIGGER_FLOOR — floor 계단 문턱
const MA_LO      = 0.05;   // w_ma = _smoothstep(profit, breakeven_trigger=0.05, 0.20)
const MA_HI      = 0.20;
const LOCK_START = 0.08;   // profit_lock_pct(lock_start=0.08)

// Lock ratio: 50→1.0×, 100→1.7×(더 많이 잠금), 0→0.3×(적게 잠금)
// [STOPFLAT-WIRE-20260818] 기산점을 라이브와 동일한 고정 0.08 로 환원
//   (구 2026-08-18 오전판: 초기손절폭 n 연동 — 라이브에 없는 동작이라 폐기).
//   tightness 배율만 계산기 고유 기능으로 유지.
function profitLockPct(profit, tightness) {
  if (profit < LOCK_START) return 0;
  const baseLr = profit * (0.50 * smoothstep(profit, LOCK_START, 0.20)
                          + 0.10 * smoothstep(profit, 0.20, 0.40));
  const mult = lerp(0.3, 1.7, tightness / 100);
  return baseLr * mult;
}

// [STOPFLAT-WIRE-20260818] 라이브 compute_stop_level() 이식 — 계단 구조.
//   구간1 (본전 미도달) → floor = 매수가 × (1 − n)  … 계단, 래칫 미적용
//   구간2 (본전 도달 후) → floor = 매수가          … 1회 점프, 래칫 재개
//   본전 도달 판정(beReached)은 **진입 후 도달 최고 종가**가 +8%(BE_FLOOR)에
//   닿았는지로 하며, 한 번 참이면 되돌아가지 않는다. 장중 고가는 쓰지 않는다.
//   미주입(null) 시에만 현재 수익률 단독으로 폴백 판정(라이브와 동일한 폴백).
function computeStop(entryPrice, currentPrice, closes, initialStopPct, tightness, beReached) {
  const profit   = (currentPrice - entryPrice) / entryPrice;
  const stopInit = entryPrice * (1 - initialStopPct);

  const be = (beReached == null) ? (profit >= BE_FLOOR) : !!beReached;
  const floorStop = be ? entryPrice : stopInit;

  const period  = maPeriodFor(profit, tightness);
  const slice   = closes.slice(-Math.min(period, closes.length));
  const maStop  = slice.reduce((a, b) => a + b, 0) / slice.length;

  const wMa     = smoothstep(profit, MA_LO, MA_HI);
  const blended = floorStop * (1 - wMa) + maStop * wMa;

  const lockPct   = profitLockPct(profit, tightness);
  const lockFloor = lockPct > 0 ? entryPrice * (1 + lockPct) : 0;

  // 래칫·하한 클램프는 호출측(simulate)에서 라이브와 동일 순서로 적용
  const stopLevel = Math.max(blended, lockFloor);

  return { profit, profitPct: profit*100, maPeriod: period, maStop, floorStop,
           blended, lockFloor, lockPct: lockPct*100, stopLevel, initialStop: stopInit,
           beReached: be, wMa, flatZone: !be };
}

// ── 시뮬레이션 (진입일~현재 래칫) ──────────────────
function simulate(entryPrice, closes, timestamps, entryDateStr, initialStopPct, tightness) {
  const entryTs = new Date(entryDateStr).getTime() / 1000 - 86400;
  let startIdx = 0;
  for (let i = 0; i < timestamps.length; i++) {
    if (timestamps[i] >= entryTs) { startIdx = i; break; }
  }
  let prevStop = 0;
  let beReached = false;      // [STOPFLAT-WIRE] 도달 최고 종가 기준, 단조 (한 번 참이면 유지)
  let maxClose  = 0;
  const stopInit = entryPrice * (1 - initialStopPct);
  const history = [];
  for (let i = startIdx; i < closes.length; i++) {
    const cp = closes[i];
    const closesNow = closes.slice(0, i + 1);

    // 진입일 이후 확정 종가의 러닝 최고치로 본전 도달 판정 (장중 고가 미사용)
    if (cp > maxClose) maxClose = cp;
    if (!beReached && (maxClose / entryPrice - 1) >= BE_FLOOR) beReached = true;

    const r = computeStop(entryPrice, cp, closesNow, initialStopPct, tightness, beReached);
    // 라이브와 동일 순서: ① 래칫(구간2 한정) ② 구간1 하한 클램프
    r.ratchetApplied = beReached && (r.stopLevel < prevStop);
    if (r.ratchetApplied) r.stopLevel = prevStop;
    r.floorClamped = (!beReached) && (r.stopLevel < stopInit);
    if (r.floorClamped) r.stopLevel = stopInit;
    prevStop = r.stopLevel;
    const d = new Date(timestamps[i] * 1000);
    const label = (d.getMonth()+1).toString().padStart(2,'0') + '/' + d.getDate().toString().padStart(2,'0');
    history.push({ label, price: cp, stop: r.stopLevel, result: r });
  }
  return history;
}

// ── Yahoo Finance ──────────────────────────────────
const PROXY = 'https://corsproxy.io/?url=';
async function fetchCloses(yfTicker) {
  const yUrl = `https://query1.finance.yahoo.com/v8/finance/chart/${yfTicker}?range=2y&interval=1d`;
  const res = await fetch(PROXY + encodeURIComponent(yUrl));
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  const js = await res.json();
  const result = js?.chart?.result?.[0];
  if (!result) throw new Error('데이터 없음');
  const raw  = result.indicators?.quote?.[0]?.close ?? [];
  const timestamps = result.timestamp ?? [];
  const closes = [], tsClean = [];
  for (let i = 0; i < raw.length; i++) {
    if (raw[i] != null && !isNaN(raw[i])) {
      closes.push(Number(raw[i]));
      tsClean.push(timestamps[i]);
    }
  }
  if (!closes.length) throw new Error('종가 데이터 없음');
  return { closes, timestamps: tsClean, currentPrice: closes[closes.length - 1] };
}

// ── 날짜 파싱 ──────────────────────────────────────
function parseDate(s) {
  s = s.trim().replace(/[\/\.\s]/g, '-');
  if (/^\d{8}$/.test(s)) s = s.slice(0,4)+'-'+s.slice(4,6)+'-'+s.slice(6,8);
  if (!/^\d{4}-\d{2}-\d{2}$/.test(s)) return null;
  const d = new Date(s + 'T00:00:00');
  if (isNaN(d.getTime())) return null;
  return s;
}

// ── UI 초기화 ──────────────────────────────────────
(function(){
  const now = new Date();
  const week = new Date(now - 7*86400e3);
  document.getElementById('entryDate').value = week.toISOString().slice(0,10);
})();

const stopPctEl      = document.getElementById('stopPct');
const stopSliderEl   = document.getElementById('stopSlider');
const tightnessEl    = document.getElementById('tightnessSlider');
const tightnessValEl = document.getElementById('tightnessVal');

stopPctEl.addEventListener('input', () => {
  stopSliderEl.value = Math.min(15, parseFloat(stopPctEl.value)||8);
  if (lastCache) rerenderFromCache();
});
stopSliderEl.addEventListener('input', () => {
  stopPctEl.value = stopSliderEl.value;
  if (lastCache) rerenderFromCache();
});
tightnessEl.addEventListener('input', () => {
  tightnessValEl.textContent = tightnessEl.value;
  if (lastCache) rerenderFromCache();
});

function fmt(v, isKr) {
  if (v == null) return '—';
  const n = Number(v);
  if (isKr) return n.toLocaleString('ko-KR') + '원';
  return '$' + n.toFixed(2);
}
function setLoading(on) {
  document.getElementById('calcBtn').disabled = on;
  document.getElementById('btnIcon').textContent = on ? '⏳' : '📊';
  document.getElementById('btnText').textContent = on ? '데이터 불러오는 중...' : 'Stop 시뮬레이션 실행';
}
function showErr(msg) {
  const b = document.getElementById('errBox');
  b.innerHTML = '❌ ' + msg;
  b.style.display = 'block';
}
function hideErr() { document.getElementById('errBox').style.display = 'none'; }

// ── 캐시 (re-render without re-fetch) ──────────────
let lastCache = null; // { closes, timestamps, currentPrice, isKr, ticker, usedTicker, entryPrice, entryDate }

function getTightness() { return parseInt(tightnessEl.value, 10); }
function getStopPct()   { return Math.max(1, Math.min(30, parseFloat(stopPctEl.value) || 8)) / 100; }

function rerenderFromCache() {
  if (!lastCache) return;
  const { closes, timestamps, currentPrice, isKr, ticker, usedTicker, entryPrice, entryDate } = lastCache;
  const stopPct  = getStopPct();
  const tightness = getTightness();

  const history = simulate(entryPrice, closes, timestamps, entryDate, stopPct, tightness);
  if (!history.length) return;

  const today   = new Date();
  const entry   = new Date(entryDate);
  const daysHeld = Math.max(0, Math.round((today - entry) / 86400e3));
  const last = history[history.length - 1];

  render({ ticker, usedTicker, isKr, daysHeld, currentPrice, entryPrice,
           stopPct, tightness, ratchetStop: last.stop, lastR: last.result, history });
}

// ── Chart 인스턴스 ──────────────────────────────────
let chartPrice = null, chartTheory = null;
function destroyChart(ref) { if (ref) { try { ref.destroy(); } catch(e){} } }

// ── 메인 계산 ──────────────────────────────────────
async function calculate() {
  hideErr();
  const ticker       = document.getElementById('ticker').value.trim().toUpperCase();
  const entryDateRaw = document.getElementById('entryDate').value;
  const entryDate    = parseDate(entryDateRaw);
  const entryPrice   = parseFloat(document.getElementById('entryPrice').value);
  const stopPct      = getStopPct();
  const tightness    = getTightness();

  if (!ticker)                        { showErr('티커를 입력해주세요'); return; }
  if (!entryDate)                     { showErr('구매일 형식 오류 — YYYY-MM-DD 또는 YYYYMMDD'); return; }
  if (!entryPrice || entryPrice <= 0) { showErr('평단가를 입력해주세요'); return; }

  setLoading(true);
  document.getElementById('result').style.display = 'none';

  const isKr = /^\d{6}$/.test(ticker);
  const candidates = isKr ? [ticker + '.KS', ticker + '.KQ'] : [ticker];
  let fetchResult = null, usedTicker = null;
  for (const t of candidates) {
    try { fetchResult = await fetchCloses(t); usedTicker = t; break; } catch(e) {}
  }
  if (!fetchResult) {
    showErr('데이터 없음 — 티커 또는 인터넷 연결을 확인해주세요');
    setLoading(false);
    return;
  }

  const { closes, timestamps, currentPrice } = fetchResult;

  // 캐시 저장
  lastCache = { closes, timestamps, currentPrice, isKr, ticker, usedTicker, entryPrice, entryDate };

  const history = simulate(entryPrice, closes, timestamps, entryDate, stopPct, tightness);
  if (!history.length) {
    showErr('진입일 이후 데이터가 없습니다 — 구매일을 확인해주세요');
    setLoading(false);
    return;
  }

  const last     = history[history.length - 1];
  const today    = new Date();
  const entry    = new Date(entryDate);
  const daysHeld = Math.max(0, Math.round((today - entry) / 86400e3));

  render({ ticker, usedTicker, isKr, daysHeld, currentPrice, entryPrice,
           stopPct, tightness, ratchetStop: last.stop, lastR: last.result, history });
  setLoading(false);
}

// ── 렌더 ──────────────────────────────────────────
function render(d) {
  const { isKr, currentPrice, entryPrice, ratchetStop, lastR, history, stopPct, tightness } = d;
  const profit = (currentPrice - entryPrice) / entryPrice * 100;

  document.getElementById('rTicker').textContent = d.ticker;
  document.getElementById('rDays').textContent   = `보유 ${d.daysHeld}일`;
  const yfEl = document.getElementById('rYfLabel');
  yfEl.textContent = (d.usedTicker !== d.ticker) ? `(${d.usedTicker})` : '';

  const banner = document.getElementById('profitBanner');
  banner.className = 'profit-banner ' + (profit > 1 ? 'positive' : profit < -0.5 ? 'negative' : 'neutral');
  document.getElementById('rProfit').textContent =
    (profit >= 0 ? '+' : '') + profit.toFixed(2) + '%';
  document.getElementById('rPriceInfo').textContent =
    `현재가 ${fmt(currentPrice, isKr)}  /  평단가 ${fmt(entryPrice, isKr)}`;

  let phaseTag = '';
  const sp   = (stopPct * 100).toFixed(1);
  const spN  = stopPct * 100;                       // ★ n (%) — 평평 구간 상단
  // [STOPFLAT-WIRE-20260818] 라이브 compute_stop_level() 의 driver 판정 순서 그대로:
  //   RATCHET → LOCK → MA → BE floor → FLAT
  const _lockDrives = (lastR.lockPct > 0) && (lastR.lockFloor >= lastR.blended - 1e-9);
  if      (lastR.floorClamped || !lastR.beReached)
                             phaseTag = `📍 구간1 (계단)\n−${sp}% 고정 · 래칫 없음`;
  else if (lastR.ratchetApplied) phaseTag = '🔒 RATCHET\n직전 Stop 유지';
  else if (_lockDrives)      phaseTag = '🔒 LOCK\n이익 잠금 사다리';
  else if (lastR.wMa >= 0.5) phaseTag = `📈 MA${lastR.maPeriod}\nMA 트레일링`;
  else                       phaseTag = '⬆️ BE floor\n본전 floor';
  document.getElementById('rPhaseTag').textContent = phaseTag;

  const stopFromCurrent = (ratchetStop - currentPrice) / currentPrice * 100;
  const stopEl = document.getElementById('rStop');
  stopEl.textContent = fmt(ratchetStop, isKr);
  stopEl.className = 'price ' + (stopFromCurrent > -5 ? 'safe' : stopFromCurrent > -10 ? 'warn' : 'danger');
  document.getElementById('rStopAway').textContent =
    `현재가 대비 ${stopFromCurrent >= 0 ? '+' : ''}${stopFromCurrent.toFixed(1)}%`;

  const spPct = (stopPct * 100).toFixed(1);
  document.getElementById('initLabel').textContent = `−${spPct}%`;
  const hintEl = document.getElementById('stopHint');
  if (hintEl) hintEl.textContent =
    `−${spPct}% 고정 유지 → 도달 최고 종가가 +8%(라이브 고정값)에 닿으면 평단가로 1회 점프`;
  const floor     = lastR.floorStop;
  const maStop    = lastR.maStop;
  const lockFloor = lastR.lockFloor;
  const lockPct   = lastR.lockPct;

  const vals = [
    { k:'floor', v: floor || 0 },
    { k:'ma',    v: maStop || 0 },
    { k:'lock',  v: lockFloor || 0 },
  ];
  // 평평 구간(<+n%)에서는 MA·lock 이 무력화되므로 승자는 항상 floor(=초기손절가)
  // 구간1은 하한 클램프가 항상 이기므로 승자 = floor 고정
  const winner = !lastR.beReached ? 'floor' : vals.reduce((a,b) => b.v > a.v ? b : a).k;

  setRow('b1','d1', fmt(lastR.initialStop, isKr), false, '');
  setRow('b2','d2', fmt(floor, isKr), winner === 'floor', 'active');
  document.getElementById('maPer').textContent = lastR.maPeriod || '';
  setRow('b3','d3', fmt(maStop, isKr), winner === 'ma', 'active');
  document.getElementById('lockLabel').textContent =
    lockPct > 0 ? `이익 ${lastR.profitPct.toFixed(1)}%의 ${lockPct.toFixed(1)}%` : '미활성';
  setRow('b4','d4', lockFloor > 0 ? fmt(lockFloor, isKr) : `미활성 (<+${sp}%)`, winner === 'lock', 'yellow');
  document.getElementById('b5').textContent = fmt(ratchetStop, isKr);

  document.getElementById('result').style.display = 'block';

  drawPriceChart(history, entryPrice, isKr, d.ticker);
  drawTheoryChart(stopPct, entryPrice, isKr, tightness);
}

function setRow(valId, dotId, text, isWinner, cls) {
  document.getElementById(valId).textContent = text;
  document.getElementById(valId).className   = isWinner ? 'bval ' + cls : 'bval';
  document.getElementById(dotId).className   = isWinner && cls ? 'dot ' + cls : 'dot';
}

// ── 차트 A: 주가 + Stop 히스토리 ──────────────────
function drawPriceChart(history, entryPrice, isKr, ticker) {
  destroyChart(chartPrice);
  const labels    = history.map(h => h.label);
  const prices    = history.map(h => h.price);
  const stops     = history.map(h => h.stop);
  const entryLine = history.map(() => entryPrice);
  const formatY   = v => isKr ? v.toLocaleString('ko-KR') + '원' : '$' + v.toFixed(2);

  const ctx = document.getElementById('chartPrice').getContext('2d');
  chartPrice = new Chart(ctx, {
    type: 'line',
    data: {
      labels,
      datasets: [
        { label: '주가', data: prices, borderColor: '#5b8ef0',
          backgroundColor: 'rgba(91,142,240,0.08)', fill: true,
          pointRadius: 0, tension: 0.15, borderWidth: 2, order: 1 },
        { label: 'Stop 라인', data: stops, borderColor: '#e74c3c',
          borderDash: [6,3], backgroundColor: 'transparent', fill: false,
          pointRadius: 0, tension: 0.1, borderWidth: 1.5, order: 2 },
        { label: '매수가', data: entryLine, borderColor: 'rgba(122,127,150,0.5)',
          borderDash: [3,4], backgroundColor: 'transparent', fill: false,
          pointRadius: 0, borderWidth: 1, order: 3 },
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { labels: { color: '#7a7f96', font: { size: 11 }, boxWidth: 14 } },
        tooltip: {
          backgroundColor: '#1a1d27', borderColor: '#2a2d3a', borderWidth: 1,
          titleColor: '#e8eaf0', bodyColor: '#7a7f96',
          callbacks: { label: ctx => ` ${ctx.dataset.label}: ${formatY(ctx.raw)}` }
        }
      },
      scales: {
        x: { ticks: { color: '#7a7f96', font: { size: 10 }, maxTicksLimit: 8, maxRotation: 0 },
             grid: { color: '#1e2130' } },
        y: { ticks: { color: '#7a7f96', font: { size: 10 }, callback: v => formatY(v) },
             grid: { color: '#1e2130' } }
      }
    }
  });
}

// ── 차트 B: 이론 Stop 곡선 (tightness 반영) ──────────
function drawTheoryChart(initialStopPct, entryPrice, isKr, tightness) {
  destroyChart(chartTheory);
  const labels = [], floorData = [], lockData = [], finalData = [];
  for (let p = -10; p <= 50; p += 1) {
    const profit = p / 100;
    labels.push(p + '%');

    // [STOPFLAT-WIRE] 이론 곡선은 경로를 모르므로 beReached 를 현재 수익률로 폴백 판정
    //   (라이브의 be_reached 미주입 폴백과 동일). 실제 보유 경로에서는 과거에 +8% 를
    //   찍었다면 현재 수익률이 그 아래여도 본전 floor 가 유지된다 — 위 시뮬레이션 참조.
    const be = profit >= BE_FLOOR;
    const floorPct = (be ? 0 : -initialStopPct) * 100;
    floorData.push(+floorPct.toFixed(2));

    const lockPct = profitLockPct(profit, tightness) * 100;
    lockData.push(lockPct > 0 ? +lockPct.toFixed(2) : null);

    // 구간1 = 하한 클램프로 −n% 고정 / 구간2 = max(본전 floor, 잠금 floor)
    const fin = be ? Math.max(floorPct, lockPct > 0 ? lockPct : floorPct)
                   : -initialStopPct * 100;
    finalData.push(+fin.toFixed(2));
  }

  const ctx2 = document.getElementById('chartTheory').getContext('2d');
  chartTheory = new Chart(ctx2, {
    type: 'line',
    data: {
      labels,
      datasets: [
        { label: '최종 Stop (매수가 대비 %)', data: finalData, borderColor: '#e74c3c',
          backgroundColor: 'rgba(231,76,60,0.07)', fill: true,
          pointRadius: 0, tension: 0.3, borderWidth: 2, order: 1 },
        { label: '이익 잠금 Floor', data: lockData, borderColor: '#f1c40f',
          backgroundColor: 'transparent', fill: false, pointRadius: 0,
          tension: 0.3, borderWidth: 1.5, borderDash: [4,3], order: 2, spanGaps: false },
        { label: 'Floor (초기손절→본전)', data: floorData, borderColor: '#5b8ef0',
          backgroundColor: 'transparent', fill: false, pointRadius: 0,
          tension: 0.3, borderWidth: 1.5, borderDash: [2,3], order: 3 },
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { labels: { color: '#7a7f96', font: { size: 11 }, boxWidth: 14 } },
        tooltip: {
          backgroundColor: '#1a1d27', borderColor: '#2a2d3a', borderWidth: 1,
          titleColor: '#e8eaf0', bodyColor: '#7a7f96',
          callbacks: {
            label: ctx => {
              if (ctx.raw == null) return null;
              return ` ${ctx.dataset.label}: ${ctx.raw >= 0 ? '+' : ''}${ctx.raw}%`;
            }
          }
        }
      },
      scales: {
        x: { ticks: { color: '#7a7f96', font: { size: 10 }, maxTicksLimit: 13, maxRotation: 0 },
             grid: { color: '#1e2130' },
             title: { display: true, text: '수익률 (진입 이후)', color: '#7a7f96', font: { size: 10 } } },
        y: { ticks: { color: '#7a7f96', font: { size: 10 }, callback: v => (v >= 0 ? '+' : '') + v + '%' },
             grid: { color: '#1e2130' },
             title: { display: true, text: 'Stop 위치 (매수가 대비)', color: '#7a7f96', font: { size: 10 } } }
      }
    }
  });
}

document.addEventListener('keydown', e => { if (e.key === 'Enter') calculate(); });
</script>
</body>
</html>
