<div class="card" style="--c:#7C3AED;--cl:#EFE7FD;--cx:#FAF7FE" data-sector="healthcare" data-ai="true" data-unicorn="false" data-verdict="can">
<div class="chead">
  <div class="ctop">
    <div class="cleft">
      <div class="tcol">
        <div class="tpill">AMLX</div>
        <div class="sbadge">RS 98</div>
        <div class="sbadge">SEPA ✓</div>
      </div>
      <div class="cmain">
        <div class="cname">Amylyx Pharmaceuticals, Inc. 🤖</div>
