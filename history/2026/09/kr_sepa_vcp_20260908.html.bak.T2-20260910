  <div class="gline"><span class="g pt-exp"><i></i><em>VCP 패턴</em> <b>확장</b></span><span class="g"><i></i><em>수축깊이</em> <b>6.7%</b></span><span class="g vt"><i></i><em>거래량</em> <b>중간</b></span><span class="g"><i></i><em>돌파전</em> <b>-3.8%</b></span></div><div class="gline"><span class="g warn"><i></i><em>Stage</em> <b>Stage3</b></span><span class="g can"><i></i><em>AI</em> <b>7/10</b></span><span class="g na" title="kr_not_in_universe"><i></i><em>매출 감속</em> <b>NA</b></span></div>
