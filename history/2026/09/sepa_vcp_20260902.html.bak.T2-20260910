  .num:nth-child(odd){border-right:1px solid #E5E7EB;}
  .num:nth-child(-n+2){border-bottom:1px solid #E5E7EB;}
  /* [MOBILE-GLINE-FIX-20260828] gl1/gl2 배지열이 좁은 화면에서 줄바꿈되는 문제 —
