    padding: 12px 16px;
    color: #ff7070;
    font-size: 0.85rem;
    margin-bottom: 18px;
    line-height: 1.6;
  }

  #result { display: none; }

  .result-ticker { display: flex; align-items: baseline; gap: 10px; margin-bottom: 14px; }
  .result-ticker .sym { font-size: 1.5rem; font-weight: 800; }
  .result-ticker .meta { color: var(--muted); font-size: 0.78rem; line-height: 1.5; }
  .result-ticker .meta span { display: block; }

  .profit-banner { display: flex; align-items: center; gap: 10px; border-radius: 10px; padding: 10px 14px; margin-bottom: 14px; }
  .profit-banner.positive { background: #0e2318; border: 1px solid #1e5c35; }
  .profit-banner.negative { background: #1e0e0e; border: 1px solid #5c1e1e; }
  .profit-banner.neutral  { background: #1a1d27; border: 1px solid var(--border); }
  .profit-banner .pct { font-size: 1.4rem; font-weight: 800; min-width: 75px; }
  .profit-banner.positive .pct { color: var(--green); }
