      <div class="stop-display">
        <div class="slabel">래칫 시뮬레이션 Stop 라인</div>
        <div class="price" id="rStop"></div>
        <div class="pct-away" id="rStopAway"></div>
      </div>

      <div class="breakdown">
        <div class="brow">
          <span class="blabel"><span class="dot" id="d1"></span>초기 손절 (<span id="initLabel">−8%</span>)</span>
