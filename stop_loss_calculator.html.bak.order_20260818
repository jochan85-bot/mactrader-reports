    <div class="card">
      <div class="result-ticker">
        <span class="sym" id="rTicker"></span>
        <span class="meta">
          <span id="rDays"></span>
          <span id="rYfLabel" style="color:#555;font-size:0.7rem;"></span>
        </span>
      </div>

      <div class="profit-banner" id="profitBanner">
        <div>
          <div class="pct" id="rProfit"></div>
          <div class="pct-detail" id="rPriceInfo"></div>
        </div>
        <div class="phase-tag" id="rPhaseTag"></div>
