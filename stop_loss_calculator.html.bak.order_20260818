  .brow { display: flex; justify-content: space-between; align-items: center; padding: 7px 0; border-bottom: 1px solid var(--border); font-size: 0.85rem; }
  .brow:last-child { border-bottom: none; }
  .brow .blabel { color: var(--muted); display: flex; align-items: center; gap: 5px; }
  .brow .bval { font-weight: 600; font-variant-numeric: tabular-nums; }
