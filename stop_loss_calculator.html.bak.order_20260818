        <span class="tightness-badge" id="tightnessVal">50</span>
        <span style="font-size:0.7rem;color:var(--muted);font-weight:400;margin-left:4px;">/ 100</span>
      </label>
      <div class="tightness-row">
        <span class="tag">여유 0</span>
        <input type="range" id="tightnessSlider" min="0" max="100" step="1" value="50">
        <span class="tag">100 밀착</span>
      </div>
      <div class="hint">50 = 기본값 · 높을수록 주가 밀착 추적 · 낮을수록 여유 있게</div>
    </div>

    <button id="calcBtn" onclick="calculate()">
      <span id="btnIcon">📊</span>
      <span id="btnText">Stop 시뮬레이션 실행</span>
    </button>
  </div>

  <div id="errBox"></div>

  <!-- 결과 -->
