    <div class="card chart-card">
      <div class="chart-title">📈 주가 + Stop 라인 히스토리</div>
      <div class="chart-wrap"><canvas id="chartPrice"></canvas></div>
    </div>

    <div class="card chart-card">
      <div class="chart-title">🔢 수익률별 Stop 라인 이론 곡선</div>
      <div class="chart-wrap"><canvas id="chartTheory"></canvas></div>
      <div style="font-size:0.72rem;color:var(--muted);margin-top:8px;line-height:1.5;">
        MA 트레일링은 실제 주가 데이터에 따라 달라지므로 이론 곡선에서는 Floor + 이익잠금만 표시합니다.
      </div>
    </div>

  </div>

  <div class="explain-compact">
    <div class="explain-title">계산 방식</div>
    <div class="phase-row">
      <div class="phase-num">0</div>
      <div class="phase-content">
        <div class="pname">평평 유지 (진입 ~ +n%)</div>
        <div class="pdesc">초기 손절을 −n% 로 잡으면 <b>수익 +n% 에 닿기 전까지 스탑을 −n% 에 그대로 둔다.</b>
          이 구간에서는 MA·이익잠금이 스탑을 끌어올리지 않는다. +n% 도달 시 본전(매수가)으로 이동.
          <br>기본값 n = 8 → −8% 손절 · +8% 에서 평단가.</div>
        <div class="formula-inline">stop = (profit &lt; n) ? entry × (1−n) : max(MA blend, lock floor)</div>
      </div>
    </div>
    <div class="phase-row">
      <div class="phase-num">1</div>
      <div class="phase-content">
        <div class="pname">MA 트레일링 전환 (+n% ~ +20%)</div>
        <div class="pdesc">수익이 커질수록 MA 기간 단축 (90일→30일 × tightness 배율), 가격을 더 밀착 추적.
          전환 시작점도 n 에 연동된다.</div>
        <div class="formula-inline">MA_period = max(10, round(base × lerp(1.5, 0.5, tightness/100)))</div>
      </div>
    </div>
    <div class="phase-row">
      <div class="phase-num">2</div>
      <div class="phase-content">
        <div class="pname">이익 잠금 사다리 (+n%~)</div>
        <div class="pdesc">이익 일부를 영구 보호 — tightness에 따라 잠금 비율 0.3x~1.7x 조절.
          기산점도 n 에 연동 (그 전에 켜지면 평평 구간이 깨지므로).</div>
        <div class="formula-inline">lock = base_lock × lerp(0.3, 1.7, tightness/100)</div>
      </div>
    </div>
    <div class="phase-row">
      <div class="phase-num">↑</div>
      <div class="phase-content">
        <div class="pname">래칫 — Stop은 절대 내려가지 않는다</div>
        <div class="pdesc">매일 재계산해도 이전 Stop보다 낮아지지 않음. 이 계산기는 진입일부터 시뮬레이션합니다.</div>
      </div>
    </div>
  </div>

  <div style="font-size:0.72rem;color:#7a7f96;line-height:1.6;border:1px solid #2a2d3a;
              border-radius:8px;padding:10px 12px;margin-top:4px;background:#14161f;">
    ⚠️ <b>라이브 엔진과의 차이</b> — 실제 <code>exit_engine_unified.py</code> 는 0 ~ +n% 구간을
    smoothstep 으로 <b>연속 블렌딩</b>합니다(예: n=8 일 때 수익 +4% 면 스탑이 이미 −4%).
    이 계산기는 요청에 따라 해당 구간을 <b>평평 유지</b>로 단순화했습니다.
    초기 손절 −n% · 본전 도달점 +n% · 래칫(스탑 하향 금지)은 라이브와 동일하며,
    P-E 분할손절은 계산기 범위에서 제외했습니다.
  </div>

  <div style="text-align:center;font-size:0.72rem;color:#3a3f55;padding-top:4px;">
    📡 Yahoo Finance · 전일 종가 기준 · LLM 없음 · 토큰 0원
  </div>

</div>

<script>
// ── 수학 ──────────────────────────────────────────
function lerp(a, b, t) { return a + (b - a) * t; }

function smoothstep(x, lo, hi) {
  if (hi <= lo) return x >= hi ? 1 : 0;
  const t = Math.max(0, Math.min(1, (x - lo) / (hi - lo)));
  return t * t * (3 - 2 * t);
}

// tightness 0~100: 50=기본값
// MA period: 50→base, 100→0.5×base(짧고 빠름), 0→1.5×base(길고 느림)
function maPeriodFor(profit, tightness) {
  const base = Math.max(30, Math.round(90 - 34.64 * Math.sqrt(Math.max(0, profit))));
  const mult = lerp(1.5, 0.5, tightness / 100);
  return Math.max(10, Math.round(base * mult));
}

// Lock ratio: 50→1.0×, 100→1.7×(더 많이 잠금), 0→0.3×(적게 잠금)
// [STOP-8% 2026-08-18] lock 사다리 기산점을 초기손절폭 n 에 연동 (구: 0.05 고정).
//   n 연동이 필수인 이유 — lock 이 n 보다 먼저 켜지면 lock floor 가 평평 구간의
//   −n% 스탑을 위로 밀어올려 "+n% 까지 −n% 유지" 규칙이 깨진다.
function profitLockPct(profit, tightness, lockStart) {
  const ls  = (lockStart == null) ? 0.08 : lockStart;
  if (profit < ls) return 0;
  const mid = Math.max(0.20, ls + 0.01);   // 구간 역전 방지 가드
  const hi  = Math.max(0.40, mid + 0.01);
  const baseLr = profit * (0.50 * smoothstep(profit, ls, mid)
                          + 0.10 * smoothstep(profit, mid, hi));
  const mult = lerp(0.3, 1.7, tightness / 100);
  return baseLr * mult;
}

// [STOP-8% 2026-08-18] 초기손절 −n% → 수익 +n% 까지 스탑을 −n% 에 그대로 유지.
//   n 은 사용자가 고른 초기손절폭이며 본전 도달점·MA 전환점·lock 기산점이 모두 n 에 연동된다.
//   (기본 n = 8% → −8% 손절, +8% 에서 평단가)
function computeStop(entryPrice, currentPrice, closes, initialStopPct, tightness) {
  const profit    = (currentPrice - entryPrice) / entryPrice;
  const stopInit  = entryPrice * (1 - initialStopPct);
  const beTrigger = initialStopPct;               // ★ n → n 연동

  // Phase 0 — 평평 유지: 수익이 +n% 에 닿기 전까지 floor 는 초기손절가 그대로.
  const floorStop = profit >= beTrigger ? entryPrice : stopInit;

  const period    = maPeriodFor(profit, tightness);
  const slice     = closes.slice(-Math.min(period, closes.length));
  const maStop    = slice.reduce((a, b) => a + b, 0) / slice.length;

  // Phase 1 — MA 전환도 +n% 부터 시작 (그 전에 켜지면 평평 구간이 깨짐)
  const maHi      = Math.max(0.20, beTrigger + 0.01);
  const wMa       = smoothstep(profit, beTrigger, maHi);
  const blended   = floorStop * (1 - wMa) + maStop * wMa;

  // Phase 2 — 이익 잠금도 +n% 부터
  const lockPct   = profitLockPct(profit, tightness, beTrigger);
  const lockFloor = lockPct > 0 ? entryPrice * (1 + lockPct) : 0;

  // 평평 구간에서는 MA·lock 이 스탑을 끌어올리지 못하도록 초기손절가로 고정
  const stopLevel = profit < beTrigger ? stopInit : Math.max(blended, lockFloor);

  return { profit, profitPct: profit*100, maPeriod: period, maStop, floorStop,
           lockFloor, lockPct: lockPct*100, stopLevel, initialStop: stopInit,
           beTrigger, flatZone: profit < beTrigger };
}

// ── 시뮬레이션 (진입일~현재 래칫) ──────────────────
function simulate(entryPrice, closes, timestamps, entryDateStr, initialStopPct, tightness) {
  const entryTs = new Date(entryDateStr).getTime() / 1000 - 86400;
  let startIdx = 0;
  for (let i = 0; i < timestamps.length; i++) {
    if (timestamps[i] >= entryTs) { startIdx = i; break; }
  }
  let prevStop = 0;
  const history = [];
  for (let i = startIdx; i < closes.length; i++) {
    const cp = closes[i];
    const closesNow = closes.slice(0, i + 1);
    const r = computeStop(entryPrice, cp, closesNow, initialStopPct, tightness);
    r.stopLevel = Math.max(r.stopLevel, prevStop);
    prevStop = r.stopLevel;
    const d = new Date(timestamps[i] * 1000);
    const label = (d.getMonth()+1).toString().padStart(2,'0') + '/' + d.getDate().toString().padStart(2,'0');
    history.push({ label, price: cp, stop: r.stopLevel, result: r });
  }
  return history;
}

// ── Yahoo Finance ──────────────────────────────────
const PROXY = 'https://corsproxy.io/?url=';
async function fetchCloses(yfTicker) {
  const yUrl = `https://query1.finance.yahoo.com/v8/finance/chart/${yfTicker}?range=2y&interval=1d`;
  const res = await fetch(PROXY + encodeURIComponent(yUrl));
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  const js = await res.json();
  const result = js?.chart?.result?.[0];
  if (!result) throw new Error('데이터 없음');
  const raw  = result.indicators?.quote?.[0]?.close ?? [];
  const timestamps = result.timestamp ?? [];
  const closes = [], tsClean = [];
  for (let i = 0; i < raw.length; i++) {
    if (raw[i] != null && !isNaN(raw[i])) {
      closes.push(Number(raw[i]));
      tsClean.push(timestamps[i]);
    }
  }
  if (!closes.length) throw new Error('종가 데이터 없음');
  return { closes, timestamps: tsClean, currentPrice: closes[closes.length - 1] };
}

// ── 날짜 파싱 ──────────────────────────────────────
function parseDate(s) {
  s = s.trim().replace(/[\/\.\s]/g, '-');
  if (/^\d{8}$/.test(s)) s = s.slice(0,4)+'-'+s.slice(4,6)+'-'+s.slice(6,8);
  if (!/^\d{4}-\d{2}-\d{2}$/.test(s)) return null;
  const d = new Date(s + 'T00:00:00');
  if (isNaN(d.getTime())) return null;
  return s;
}

// ── UI 초기화 ──────────────────────────────────────
(function(){
  const now = new Date();
  const week = new Date(now - 7*86400e3);
  document.getElementById('entryDate').value = week.toISOString().slice(0,10);
})();

const stopPctEl      = document.getElementById('stopPct');
const stopSliderEl   = document.getElementById('stopSlider');
const tightnessEl    = document.getElementById('tightnessSlider');
const tightnessValEl = document.getElementById('tightnessVal');

stopPctEl.addEventListener('input', () => {
  stopSliderEl.value = Math.min(15, parseFloat(stopPctEl.value)||8);
  if (lastCache) rerenderFromCache();
});
stopSliderEl.addEventListener('input', () => {
  stopPctEl.value = stopSliderEl.value;
  if (lastCache) rerenderFromCache();
});
tightnessEl.addEventListener('input', () => {
  tightnessValEl.textContent = tightnessEl.value;
  if (lastCache) rerenderFromCache();
});

function fmt(v, isKr) {
  if (v == null) return '—';
  const n = Number(v);
  if (isKr) return n.toLocaleString('ko-KR') + '원';
  return '$' + n.toFixed(2);
}
function setLoading(on) {
  document.getElementById('calcBtn').disabled = on;
  document.getElementById('btnIcon').textContent = on ? '⏳' : '📊';
  document.getElementById('btnText').textContent = on ? '데이터 불러오는 중...' : 'Stop 시뮬레이션 실행';
}
function showErr(msg) {
  const b = document.getElementById('errBox');
  b.innerHTML = '❌ ' + msg;
  b.style.display = 'block';
}
function hideErr() { document.getElementById('errBox').style.display = 'none'; }

// ── 캐시 (re-render without re-fetch) ──────────────
let lastCache = null; // { closes, timestamps, currentPrice, isKr, ticker, usedTicker, entryPrice, entryDate }

function getTightness() { return parseInt(tightnessEl.value, 10); }
function getStopPct()   { return Math.max(1, Math.min(30, parseFloat(stopPctEl.value) || 8)) / 100; }

function rerenderFromCache() {
  if (!lastCache) return;
  const { closes, timestamps, currentPrice, isKr, ticker, usedTicker, entryPrice, entryDate } = lastCache;
  const stopPct  = getStopPct();
  const tightness = getTightness();

  const history = simulate(entryPrice, closes, timestamps, entryDate, stopPct, tightness);
  if (!history.length) return;

  const today   = new Date();
  const entry   = new Date(entryDate);
  const daysHeld = Math.max(0, Math.round((today - entry) / 86400e3));
  const last = history[history.length - 1];

  render({ ticker, usedTicker, isKr, daysHeld, currentPrice, entryPrice,
           stopPct, tightness, ratchetStop: last.stop, lastR: last.result, history });
}

// ── Chart 인스턴스 ──────────────────────────────────
let chartPrice = null, chartTheory = null;
function destroyChart(ref) { if (ref) { try { ref.destroy(); } catch(e){} } }

// ── 메인 계산 ──────────────────────────────────────
async function calculate() {
  hideErr();
  const ticker       = document.getElementById('ticker').value.trim().toUpperCase();
  const entryDateRaw = document.getElementById('entryDate').value;
  const entryDate    = parseDate(entryDateRaw);
  const entryPrice   = parseFloat(document.getElementById('entryPrice').value);
  const stopPct      = getStopPct();
  const tightness    = getTightness();

  if (!ticker)                        { showErr('티커를 입력해주세요'); return; }
  if (!entryDate)                     { showErr('구매일 형식 오류 — YYYY-MM-DD 또는 YYYYMMDD'); return; }
  if (!entryPrice || entryPrice <= 0) { showErr('평단가를 입력해주세요'); return; }

  setLoading(true);
  document.getElementById('result').style.display = 'none';

  const isKr = /^\d{6}$/.test(ticker);
  const candidates = isKr ? [ticker + '.KS', ticker + '.KQ'] : [ticker];
  let fetchResult = null, usedTicker = null;
  for (const t of candidates) {
    try { fetchResult = await fetchCloses(t); usedTicker = t; break; } catch(e) {}
  }
  if (!fetchResult) {
    showErr('데이터 없음 — 티커 또는 인터넷 연결을 확인해주세요');
    setLoading(false);
    return;
  }

  const { closes, timestamps, currentPrice } = fetchResult;

  // 캐시 저장
  lastCache = { closes, timestamps, currentPrice, isKr, ticker, usedTicker, entryPrice, entryDate };

  const history = simulate(entryPrice, closes, timestamps, entryDate, stopPct, tightness);
  if (!history.length) {
    showErr('진입일 이후 데이터가 없습니다 — 구매일을 확인해주세요');
    setLoading(false);
    return;
  }

  const last     = history[history.length - 1];
  const today    = new Date();
  const entry    = new Date(entryDate);
  const daysHeld = Math.max(0, Math.round((today - entry) / 86400e3));

  render({ ticker, usedTicker, isKr, daysHeld, currentPrice, entryPrice,
           stopPct, tightness, ratchetStop: last.stop, lastR: last.result, history });
  setLoading(false);
}

// ── 렌더 ──────────────────────────────────────────
function render(d) {
  const { isKr, currentPrice, entryPrice, ratchetStop, lastR, history, stopPct, tightness } = d;
  const profit = (currentPrice - entryPrice) / entryPrice * 100;

  document.getElementById('rTicker').textContent = d.ticker;
  document.getElementById('rDays').textContent   = `보유 ${d.daysHeld}일`;
  const yfEl = document.getElementById('rYfLabel');
  yfEl.textContent = (d.usedTicker !== d.ticker) ? `(${d.usedTicker})` : '';

  const banner = document.getElementById('profitBanner');
  banner.className = 'profit-banner ' + (profit > 1 ? 'positive' : profit < -0.5 ? 'negative' : 'neutral');
  document.getElementById('rProfit').textContent =
    (profit >= 0 ? '+' : '') + profit.toFixed(2) + '%';
  document.getElementById('rPriceInfo').textContent =
    `현재가 ${fmt(currentPrice, isKr)}  /  평단가 ${fmt(entryPrice, isKr)}`;

  let phaseTag = '';
  const sp   = (stopPct * 100).toFixed(1);
  const spN  = stopPct * 100;                       // ★ n (%) — 평평 구간 상단
  const maHiPct = Math.max(20, spN + 1);
  if      (profit < 0)     phaseTag = `📍 손절 구간\n초기 −${sp}% 적용`;
  else if (profit < spN)   phaseTag = `📍 Phase 0\n−${sp}% 평평 유지`;
  else if (profit < maHiPct) phaseTag = '📈 Phase 1\nMA 트레일링';
  else                     phaseTag = '🔒 Phase 2\n이익 잠금';
  document.getElementById('rPhaseTag').textContent = phaseTag;

  const stopFromCurrent = (ratchetStop - currentPrice) / currentPrice * 100;
  const stopEl = document.getElementById('rStop');
  stopEl.textContent = fmt(ratchetStop, isKr);
  stopEl.className = 'price ' + (stopFromCurrent > -5 ? 'safe' : stopFromCurrent > -10 ? 'warn' : 'danger');
  document.getElementById('rStopAway').textContent =
    `현재가 대비 ${stopFromCurrent >= 0 ? '+' : ''}${stopFromCurrent.toFixed(1)}%`;

  const spPct = (stopPct * 100).toFixed(1);
  document.getElementById('initLabel').textContent = `−${spPct}%`;
  const hintEl = document.getElementById('stopHint');
  if (hintEl) hintEl.textContent =
    `−${spPct}% 설정 시 수익 +${spPct}%까지 −${spPct}% 유지 → +${spPct}% 도달 시 평단가로 이동`;
  const floor     = lastR.floorStop;
  const maStop    = lastR.maStop;
  const lockFloor = lastR.lockFloor;
  const lockPct   = lastR.lockPct;

  const vals = [
    { k:'floor', v: floor || 0 },
    { k:'ma',    v: maStop || 0 },
    { k:'lock',  v: lockFloor || 0 },
  ];
  // 평평 구간(<+n%)에서는 MA·lock 이 무력화되므로 승자는 항상 floor(=초기손절가)
  const winner = lastR.flatZone ? 'floor' : vals.reduce((a,b) => b.v > a.v ? b : a).k;

  setRow('b1','d1', fmt(lastR.initialStop, isKr), false, '');
  setRow('b2','d2', fmt(floor, isKr), winner === 'floor', 'active');
  document.getElementById('maPer').textContent = lastR.maPeriod || '';
  setRow('b3','d3', fmt(maStop, isKr), winner === 'ma', 'active');
  document.getElementById('lockLabel').textContent =
    lockPct > 0 ? `이익 ${lastR.profitPct.toFixed(1)}%의 ${lockPct.toFixed(1)}%` : '미활성';
  setRow('b4','d4', lockFloor > 0 ? fmt(lockFloor, isKr) : `미활성 (<+${sp}%)`, winner === 'lock', 'yellow');
  document.getElementById('b5').textContent = fmt(ratchetStop, isKr);

  document.getElementById('result').style.display = 'block';

  drawPriceChart(history, entryPrice, isKr, d.ticker);
  drawTheoryChart(stopPct, entryPrice, isKr, tightness);
}

function setRow(valId, dotId, text, isWinner, cls) {
  document.getElementById(valId).textContent = text;
  document.getElementById(valId).className   = isWinner ? 'bval ' + cls : 'bval';
  document.getElementById(dotId).className   = isWinner && cls ? 'dot ' + cls : 'dot';
}

// ── 차트 A: 주가 + Stop 히스토리 ──────────────────
function drawPriceChart(history, entryPrice, isKr, ticker) {
  destroyChart(chartPrice);
  const labels    = history.map(h => h.label);
  const prices    = history.map(h => h.price);
  const stops     = history.map(h => h.stop);
  const entryLine = history.map(() => entryPrice);
  const formatY   = v => isKr ? v.toLocaleString('ko-KR') + '원' : '$' + v.toFixed(2);

  const ctx = document.getElementById('chartPrice').getContext('2d');
  chartPrice = new Chart(ctx, {
    type: 'line',
    data: {
      labels,
      datasets: [
        { label: '주가', data: prices, borderColor: '#5b8ef0',
          backgroundColor: 'rgba(91,142,240,0.08)', fill: true,
          pointRadius: 0, tension: 0.15, borderWidth: 2, order: 1 },
        { label: 'Stop 라인', data: stops, borderColor: '#e74c3c',
          borderDash: [6,3], backgroundColor: 'transparent', fill: false,
          pointRadius: 0, tension: 0.1, borderWidth: 1.5, order: 2 },
        { label: '매수가', data: entryLine, borderColor: 'rgba(122,127,150,0.5)',
          borderDash: [3,4], backgroundColor: 'transparent', fill: false,
          pointRadius: 0, borderWidth: 1, order: 3 },
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { labels: { color: '#7a7f96', font: { size: 11 }, boxWidth: 14 } },
        tooltip: {
          backgroundColor: '#1a1d27', borderColor: '#2a2d3a', borderWidth: 1,
          titleColor: '#e8eaf0', bodyColor: '#7a7f96',
          callbacks: { label: ctx => ` ${ctx.dataset.label}: ${formatY(ctx.raw)}` }
        }
      },
      scales: {
        x: { ticks: { color: '#7a7f96', font: { size: 10 }, maxTicksLimit: 8, maxRotation: 0 },
             grid: { color: '#1e2130' } },
        y: { ticks: { color: '#7a7f96', font: { size: 10 }, callback: v => formatY(v) },
             grid: { color: '#1e2130' } }
      }
    }
  });
}

// ── 차트 B: 이론 Stop 곡선 (tightness 반영) ──────────
function drawTheoryChart(initialStopPct, entryPrice, isKr, tightness) {
  destroyChart(chartTheory);
  const labels = [], floorData = [], lockData = [], finalData = [];
  for (let p = -10; p <= 50; p += 1) {
    const profit = p / 100;
    labels.push(p + '%');

    const beTrigger = initialStopPct;                 // ★ n → n 연동
    // 평평 유지: 수익이 +n% 에 닿기 전까지 floor = −n% 고정
    const floorPct = (profit >= beTrigger ? 0 : -initialStopPct) * 100;
    floorData.push(+floorPct.toFixed(2));

    const lockPct = profitLockPct(profit, tightness, beTrigger) * 100;
    lockData.push(lockPct > 0 ? +lockPct.toFixed(2) : null);

    const fin = profit < beTrigger
      ? -initialStopPct * 100
      : Math.max(floorPct, lockPct > 0 ? lockPct : floorPct);
    finalData.push(+fin.toFixed(2));
  }

  const ctx2 = document.getElementById('chartTheory').getContext('2d');
  chartTheory = new Chart(ctx2, {
    type: 'line',
    data: {
      labels,
      datasets: [
        { label: '최종 Stop (매수가 대비 %)', data: finalData, borderColor: '#e74c3c',
          backgroundColor: 'rgba(231,76,60,0.07)', fill: true,
          pointRadius: 0, tension: 0.3, borderWidth: 2, order: 1 },
        { label: '이익 잠금 Floor', data: lockData, borderColor: '#f1c40f',
          backgroundColor: 'transparent', fill: false, pointRadius: 0,
          tension: 0.3, borderWidth: 1.5, borderDash: [4,3], order: 2, spanGaps: false },
        { label: 'Floor (초기손절→본전)', data: floorData, borderColor: '#5b8ef0',
          backgroundColor: 'transparent', fill: false, pointRadius: 0,
          tension: 0.3, borderWidth: 1.5, borderDash: [2,3], order: 3 },
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { labels: { color: '#7a7f96', font: { size: 11 }, boxWidth: 14 } },
        tooltip: {
          backgroundColor: '#1a1d27', borderColor: '#2a2d3a', borderWidth: 1,
          titleColor: '#e8eaf0', bodyColor: '#7a7f96',
          callbacks: {
            label: ctx => {
              if (ctx.raw == null) return null;
              return ` ${ctx.dataset.label}: ${ctx.raw >= 0 ? '+' : ''}${ctx.raw}%`;
            }
          }
        }
      },
      scales: {
        x: { ticks: { color: '#7a7f96', font: { size: 10 }, maxTicksLimit: 13, maxRotation: 0 },
             grid: { color: '#1e2130' },
             title: { display: true, text: '수익률 (진입 이후)', color: '#7a7f96', font: { size: 10 } } },
        y: { ticks: { color: '#7a7f96', font: { size: 10 }, callback: v => (v >= 0 ? '+' : '') + v + '%' },
             grid: { color: '#1e2130' },
             title: { display: true, text: 'Stop 위치 (매수가 대비)', color: '#7a7f96', font: { size: 10 } } }
      }
    }
  });
}

document.addEventListener('keydown', e => { if (e.key === 'Enter') calculate(); });
