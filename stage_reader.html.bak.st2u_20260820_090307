<title>Stage 판독기 — MacTrader</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="stage_algo.js"></script>
<style>
  :root {
    --bg:      #0f1117;
    --card:    #1a1d27;
    --border:  #2a2d3a;
    --accent:  #5b8ef0;
    --accent2: #7c6fff;
    --green:   #2ecc71;
    --red:     #e74c3c;
    --yellow:  #f1c40f;
    --text:    #e8eaf0;
    --muted:   #7a7f96;
    --input-bg:#22253a;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, 'Segoe UI', sans-serif;
    min-height: 100vh;
    padding: 32px 16px 80px;
  }
  h1 {
    text-align: center;
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 4px;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .subtitle { text-align: center; color: var(--muted); font-size: 0.82rem; margin-bottom: 32px; }
  .container { max-width: 640px; margin: 0 auto; }

  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 24px 24px 20px;
    margin-bottom: 18px;
  }
  .card-title { font-size: 0.78rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-bottom: 18px; }

  .field { margin-bottom: 14px; }
  .field label { display: block; font-size: 0.78rem; color: var(--muted); margin-bottom: 5px; font-weight: 500; }
  .field input[type="text"] {
    width: 100%;
    background: var(--input-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px 14px;
    color: var(--text);
    font-size: 0.95rem;
  }
  .field input:focus { outline: none; border-color: var(--accent); }
  .hint { font-size: 0.72rem; color: var(--muted); margin-top: 5px; line-height: 1.5; }

  #readBtn {
    width: 100%;
    padding: 13px;
    border: none;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: #fff;
    font-size: 0.97rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity .2s, transform .1s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 4px;
  }
  #readBtn:hover { opacity: .9; }
  #readBtn:active { transform: scale(0.98); }
  #readBtn:disabled { opacity: .5; cursor: not-allowed; }

  #errBox {
    display: none;
    background: #2b1218;
    border: 1px solid var(--red);
    border-radius: 12px;
    padding: 12px 16px;
    color: #ff7070;
    font-size: 0.85rem;
    margin-bottom: 18px;
    line-height: 1.6;
  }

  #result { display: none; }

  .stage-badge {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 1.35rem; font-weight: 800;
    padding: 10px 18px; border-radius: 12px;
    margin-bottom: 4px;
  }
  .stage-badge.st2   { background: rgba(46,204,113,.14); color: var(--green); border: 1px solid rgba(46,204,113,.35); }
  .stage-badge.st2e  { background: rgba(241,196,15,.14); color: var(--yellow); border: 1px solid rgba(241,196,15,.35); }
  .stage-badge.st134 { background: rgba(231,76,60,.14); color: var(--red); border: 1px solid rgba(231,76,60,.35); }
  .stage-badge.na    { background: rgba(122,127,150,.14); color: var(--muted); border: 1px solid var(--border); }

  .subrow { font-size: 0.8rem; color: var(--muted); margin: 10px 0 16px; line-height: 1.7; }
  .subrow b { color: var(--text); }

  .kvgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 4px; }
  .kv { background: var(--input-bg); border: 1px solid var(--border); border-radius: 10px; padding: 9px 12px; }
  .kv .k { font-size: 0.7rem; color: var(--muted); }
  .kv .v { font-size: 0.92rem; font-weight: 700; margin-top: 2px; }

  .glossary { font-size: 0.74rem; color: var(--muted); line-height: 1.9; margin-top: 14px; padding-top: 12px; border-top: 1px dashed var(--border); }
  .glossary b { color: #a8c0ff; }

  .src-line { font-size: 0.7rem; color: var(--muted); margin-top: 10px; }

  .disclaimer {
    background: rgba(241,196,15,.06);
    border: 1px solid rgba(241,196,15,.28);
    border-radius: 12px;
    padding: 14px 16px;
    font-size: 0.78rem;
    color: #d8d2b8;
    line-height: 1.75;
    margin-top: 4px;
  }
  .disclaimer b { color: var(--yellow); }

  #chartCard { display: none; }
  .chart-wrap { position: relative; height: 300px; margin-bottom: 4px; }
  .clegend { display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 0.7rem; color: var(--muted); margin-top: 10px; }
  .clegend span { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
  .clegend i { display: inline-block; width: 11px; height: 11px; border-radius: 3px; }
  .clegend u { display: inline-block; width: 14px; height: 0; border-top: 2px solid; text-decoration: none; }
  .bevents { margin-top: 12px; padding-top: 10px; border-top: 1px dashed var(--border); font-size: 0.75rem; line-height: 1.85; color: var(--muted); }
  .bevents b { color: var(--text); }
  .bevents .rst { color: var(--red); font-weight: 700; }
  .bevents .row { display: flex; gap: 8px; }
  .bevents .row .bk { flex: none; width: 30px; font-weight: 700; color: #a8c0ff; }

  .backlink { display: block; text-align: center; margin-top: 22px; }
  .backlink a { color: var(--muted); font-size: 0.82rem; text-decoration: none; }
  .backlink a:hover { color: var(--text); }
</style>
